{
  "name": "together",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "build:cloud": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx cloud/local-server.ts",
    "dev:cloud": "wrangler dev --config wrangler.cloud.jsonc",
    "companion:cloud": "tsx scripts/cloud-companion.ts",
    "types:cloud": "wrangler types --config wrangler.cloud.jsonc && tsc --ignoreConfig --noEmit --skipLibCheck --target ES2022 --lib ES2022,DOM,ESNext.Disposable --strict false --module ESNext --moduleResolution Bundler --allowImportingTsExtensions scripts/binding-typecheck.ts",
    "build:byo-mcp": "node scripts/build-byo-mcp.mjs",
    "pretest": "npm run build:byo-mcp",
    "start": "tsx scripts/start-local.mts",
    "smoke:local": "tsx scripts/smoke-local.mts",
    "build:sites": "vite build --config vite.config.ts && node scripts/prepare-sites-build.mjs",
    "deploy:cloud": "npm run build:cloud && wrangler deploy --config wrangler.cloud.jsonc",
    "check:cloud": "npm run build:cloud && wrangler deploy --config wrangler.cloud.jsonc --dry-run --outdir .runtime/cloud-bundle"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "12.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "description": "A shared workspace for people and AI agents to coordinate code changes, checks, reviews and integration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleepficus/together.git"
  }
}
