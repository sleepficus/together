# Optional outbound companion; replace values in your shell or private env file.
# This example is not loaded automatically and contains no usable credentials.
TOGETHER_CLOUD_API_URL=https://YOUR_WORKER.YOUR_SUBDOMAIN.workers.dev
TOGETHER_PROJECT_IDS=your-project-id
TOGETHER_GIT_BRIDGE_TOKEN_FILE=/absolute/owned/path/git-bridge-token
TOGETHER_CHECK_BRIDGE_TOKEN_FILE=/absolute/owned/path/check-bridge-token
TOGETHER_COMPANION_SCRATCH=/absolute/owned/path/together-scratch
TOGETHER_DOCKER_BIN=docker
